{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive-git.py\"",
            "timeout": 10,
            "statusMessage": "Checking git safety…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-guard.sh\"",
            "timeout": 30,
            "statusMessage": "format + lint gate…"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-hard-wrap.py\"",
            "timeout": 10,
            "statusMessage": "checking markdown line wrapping…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/repo-sync.sh\"",
            "timeout": 30,
            "statusMessage": "Syncing to latest origin/main…"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
