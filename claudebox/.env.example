# Copy to .env and fill in. .env is git-ignored.

# Host folder that holds Claude Code's .credentials.json and settings.json (forward slashes).
# Windows: C:/Users/you/.claude   macOS/Linux: /Users/you/.claude or /home/you/.claude
# macOS keeps credentials in the Keychain (no .credentials.json), so set CLAUDE_CODE_OAUTH_TOKEN there.
HOST_CLAUDE_DIR=C:/Users/you/.claude

# Project folder to mount at /workspace (defaults to this folder).
PROJECT_DIR=.

# Preferred for subscriptions: run `claude setup-token` on the host and paste the result.
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative: a Console API key. Leave empty to use the subscription.
ANTHROPIC_API_KEY=

# Linux/WSL only: your `id -u` and `id -g`, so files written in /workspace are owned by you.
CLAUDEBOX_UID=1000
CLAUDEBOX_GID=1000

# Pin the Claude Code version baked into the image.
CLAUDE_CODE_VERSION=latest
TZ=Africa/Johannesburg

# --- API server (docker compose up -d claudebox-server) ---
# Host port for the OpenAI-compatible API (3000 clashes with a local Multica web app).
CLAUDEBOX_PORT=3210
# If set, /v1/* requests must send "Authorization: Bearer <this>". Empty = no auth.
CLAUDEBOX_API_KEY=
# Max simultaneous claude runs the server will accept.
MAX_CONCURRENT=4

# 1 = copy host settings.json into the container on first run; 0 = skip (e.g. host hooks
# call binaries that don't exist in the container).
CLAUDEBOX_SEED_SETTINGS=0

# --- Multica daemon (optional: docker compose up -d multica-daemon) ---
# Leave MULTICA_TOKEN empty if you don't use Multica; nothing else depends on it.
# Server as seen from inside the container. Multica running on this host = host.docker.internal.
MULTICA_SERVER_URL=http://host.docker.internal:8080
MULTICA_APP_URL=http://host.docker.internal:3000
# Personal access token (mul_...). Create one in Multica settings, or reuse ~/.multica/config.json.
MULTICA_TOKEN=
# Optional: limit to one workspace. Empty = all workspaces the token can see.
MULTICA_WORKSPACE_ID=
MULTICA_VERSION=latest

# --- OpenAPPA (always on; every Claude session runs through clappa) ---
APPA_VERSION=v0.31.1

# --- SPIFFE / SPIRE (run ./spire/bootstrap.sh once) ---
SPIRE_VERSION=1.15.3
