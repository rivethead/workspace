# Files that run inside the Linux container must keep LF endings, even when cloned on
# Windows with core.autocrlf=true. A CRLF entrypoint fails with "bad interpreter".
*.sh            text eol=lf
entrypoint.sh   text eol=lf
*.js            text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
.env.example    text eol=lf
bin/claudebox  text eol=lf
*.ps1          text eol=crlf
