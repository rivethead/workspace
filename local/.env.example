# Copied to .env by scripts/up.sh, which fills JWT_SECRET. .env is git-ignored.
JWT_SECRET=

# Host ports (127.0.0.1 only).
MULTICA_WEB_PORT=3000
MULTICA_API_PORT=8080
MAILPIT_PORT=8025
POSTGRES_PORT=55432
SPIRE_PORT=8081

# Your own address: owns the local Multica workspace. Any example.com address
# works, because Mailpit catches all mail.
SPONSOR_EMAIL=

# Who may sign up to Multica (plan D3). Invitations bypass this list.
ALLOWED_EMAIL_DOMAINS=example.com

MULTICA_VERSION=v0.6.1
SPIRE_VERSION=1.15.3
MAILPIT_VERSION=v1.31.2

BROKER_PORT=8443
# The broker's read-only admin UI (127.0.0.1 only).
BROKER_ADMIN_PORT=15000
SOCAT_VERSION=1.8.0.3
AGENTGATEWAY_VERSION=v1.5.0

# Tornjak, the SPIRE web view: UI and API ports (127.0.0.1 only).
TORNJAK_VERSION=v2.1.0
TORNJAK_PORT=3001
TORNJAK_API_PORT=10000
# Tornjak's API goes through a read-only proxy (docs/threat-model.md, TM-T6).
NGINX_VERSION=1.27.5-alpine
